{
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "gsd-core": {
      "source": {
        "source": "github",
        "repo": "open-gsd/gsd-core"
      }
    }
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "superpowers@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "volt@volt-main": true,
    "gsd-core@gsd-core": false
  },
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(npm publish:*)",
      "Bash(printenv:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__pull_request_review_write"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(pip install:*)",
      "mcp__stripe__stripe_api_write",
      "mcp__stripe__send_money",
      "mcp__stripe__transfer_money",
      "mcp__stripe__convert_currency",
      "mcp__stripe__setup_recipient",
      "mcp__stripe__atlas_company_formation"
    ],
    "allow": [
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm ci --ignore-scripts)",
      "Bash(node tests/:*)",
      "Bash(node scripts/ci/:*)",
      "Bash(claude plugin validate:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/volt/hooks/team-guard.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|PowerShell|Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/volt/hooks/readonly-agents.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$VOLT_TEAM\" = 1 ] || exit 0; bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tdd-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/volt/hooks/loop-breaker.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$VOLT_TEAM\" = 1 ] || exit 0; bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tdd-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/volt/hooks/loop-breaker.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$VOLT_TEAM\" = 1 ] || exit 0; bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tdd-gate.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$VOLT_TEAM\" = 1 ] || exit 0; bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tdd-gate.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "[ \"$VOLT_TEAM\" = 1 ] || exit 0; bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scope-guard.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/volt/hooks/subagent-log.js",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/volt/hooks/subagent-log.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
