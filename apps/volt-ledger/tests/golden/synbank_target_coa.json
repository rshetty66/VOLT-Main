  "decisions": [
   {
    "topic": "IFRS 9 credit stage",
    "choice": "Capture stage as a segment on loan and allowance accounts",
    "alternatives": [
     "Separate natural accounts per stage"
    ],
    "rationale": "Stage moves every quarter; a segment avoids reclassification journals between accounts and keeps one natural account per product.",
    "standard_refs": [
     "IFRS 9.5.5"
    ]
   },
   {
    "topic": "Business line",
    "choice": "Business line is a mandatory segment, default Unassigned until allocated",
    "alternatives": [
     "Business line in the account code",
     "Optional segment"
    ],
    "rationale": "The legacy chart built business lines into insurance commission codes; a mandatory segment gives complete business-line profitability.",
    "standard_refs": [
     "IFRS 8.5"
    ]
   },
   {
    "topic": "Card interchange",
    "choice": "Record interchange gross and scheme costs separately",
    "alternatives": [
     "Keep net presentation"
    ],
    "rationale": "Gross amounts are needed to assess principal versus agent and to disclose fee income and expense.",
    "standard_refs": [
     "IFRS 15.B34"
    ]
   },
   {
    "topic": "Software development",
    "choice": "Separate expensed development from capitalised software",
    "alternatives": [
     "One IT cost account"
    ],
    "rationale": "Capitalisation criteria must be evidenced; separate accounts make the split auditable.",
    "standard_refs": [
     "IAS 38.57"
    ]
   },
   {
    "topic": "Sundry income",
    "choice": "Retire sundry income; post to other operating income with a description rule",
    "alternatives": [
     "Keep a sundry account"
    ],
    "rationale": "A catch-all balance cannot be mapped or explained.",
    "standard_refs": []
   },
   {
    "topic": "Leases",
    "choice": "Rent account limited to short-term and low-value leases",
    "alternatives": [
     "One rent account"
    ],
    "rationale": "Other leases sit in right-of-use assets and lease liabilities; under US GAAP operating leases the parent view needs a lease cost adjustment.",
    "standard_refs": [
     "IFRS 16.6",
     "ASC 842-20-25-6"
    ]
   }
  ]
 },
