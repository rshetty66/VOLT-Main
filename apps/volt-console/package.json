{
  "name": "volt-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VOLT Console: React UI and Claude-powered multi-agent API over the VOLT Claude Code plugin",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build && tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node build/server/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "reset-password": "tsx server/reset-password.ts",
    "eval": "tsx evals/run.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@electric-sql/pglite": "0.5.8",
    "docx": "9.8.1",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "helmet": "8.3.0",
    "jszip": "3.10.2",
    "pptxgenjs": "4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "tsx": "^4.23.15",
    "unified": "11.0.5",
    "unpdf": "1.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "^5.0.6",
    "@types/mdast": "4.0.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "image-size": "2.0.4",
    "uuid": "11.1.1"
  }
}
