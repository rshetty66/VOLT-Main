{
  "name": "volt-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VOLT Console: React UI and Claude-powered multi-agent API over the VOLT Claude Code plugin",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "add-user": "tsx scripts/add-user.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@xyflow/react": "^12.12.1",
    "docx": "9.14.0",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "gifenc": "1.0.3",
    "mermaid": "11.17.2",
    "pptxgenjs": "4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "11.0.0",
    "reveal.js": "5.2.1",
    "tsx": "^4.23.15",
    "unified": "11.0.5",
    "unpdf": "2.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "undici": "6.29.1",
    "body-parser": "2.4.0",
    "zod": "$zod",
    "pptxgenjs": {
      "image-size": "2.0.4"
    },
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
