{
  "name": "volt-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VOLT Console: React UI and Claude-powered multi-agent API over the VOLT Claude Code plugin",
  "scripts": {
    "dev": "concurrently -n api,web,copilot,agent -c blue,magenta,green,yellow \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:copilot\" \"npm:dev:agent\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "dev:copilot": "tsx watch server/copilotkit.ts",
    "dev:agent": "cd agent && npx @langchain/langgraph-cli dev --port 8123 --no-browser",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@copilotkit/react-core": "1.84.1",
    "@copilotkit/runtime": "1.84.1",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
