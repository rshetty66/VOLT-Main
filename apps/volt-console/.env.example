# Claude credentials (any one). Without them the console runs in demo mode.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_WORKSPACE_ID=      # wrkspc_..., needed when the key is not scoped to one workspace
# ANTHROPIC_BASE_URL=          # gateway, as VOLT supports

# VOLT_MODEL=claude-opus-5-5
# VOLT_ORCHESTRATOR_EFFORT=high   # low | medium | high | xhigh | max
# VOLT_SPECIALIST_EFFORT=medium
# Cost control defaults; an admin can change all of these under Usage, which takes precedence.
# VOLT_SPECIALIST_MODEL=claude-opus-5-5   # model for workflow and consulted specialists
# VOLT_SPECIALIST_MAX_STEPS=6             # model calls per specialist before it must answer
# VOLT_RUN_BUDGET_USD=10                  # a run stops at this estimated cost (0 = no limit)
# VOLT_MONTHLY_BUDGET_USD=100             # default monthly limit per person (0 = no limit)
# VOLT_FALLBACKS=on               # server-side refusal fallback; set off for gateways/Bedrock/Vertex
# VOLT_MODE=                      # force "live" or "demo"
# VOLT_PLUGIN_DIR=../../plugins/volt   # the VOLT plugin the console reads
# VOLT_DATA_DIR=./.volt-data           # where saved engagements and runs are kept (embedded Postgres)
# PORT=8787
# VOLT_AUTO_RESUME=on             # resume workflow runs a restart interrupted (off to disable)
# Hardening (A6)
# VOLT_ALLOWED_ORIGINS=           # extra origins allowed to change data, e.g. https://volt.example.com
# VOLT_RATE_LIMIT=600             # API requests a minute per person
# VOLT_TRUST_PROXY=               # 1 behind a reverse proxy, so rate limits see client addresses
# VOLT_LOG_FORMAT=                # json | pretty (default: json when NODE_ENV=production)
# VOLT_LOG_LEVEL=info             # debug | info | warn | error | silent
