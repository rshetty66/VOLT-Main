# Claude credentials (any one). Without them the console runs in demo mode.
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=          # gateway, as VOLT supports

# VOLT_ROUTING=on                 # off: every step on the Opus-tier model (no Haiku triage, no Sonnet steps)
# VOLT_MODEL_OPUS=claude-opus-5-5 # lead on client deliverables, workflow synthesis (VOLT_MODEL also sets this)
# VOLT_MODEL_SONNET=claude-sonnet-5-5   # specialists, workflow phases, quick asks, direct questions
# VOLT_MODEL_HAIKU=claude-haiku-5-5     # request triage
# Other providers: specialist workstreams only (the lead stays on Claude). Each key adds an option to the Specialists selector.
# OPENAI_API_KEY=                  # GPT through the Responses API
# XAI_API_KEY=                     # Grok through the Responses API
# VOLT_MODEL_GPT=gpt-6.2-sol       # same list price as Sonnet ($2 / $10 per million tokens)
# VOLT_MODEL_GROK=grok-4.3         # $1.25 / $2.50
# VOLT_MODEL_GROK_CODE=grok-code-fast-1   # code-like briefs in Auto; if xAI has retired it, set grok-4.7
# VOLT_ORCHESTRATOR_EFFORT=high   # low | medium | high | xhigh | max
# VOLT_SPECIALIST_EFFORT=medium
# VOLT_FALLBACKS=on               # server-side refusal fallback; set off for gateways/Bedrock/Vertex
# VOLT_WEB_RESEARCH=off          # on: agents search and read the web and cite the pages (USD 10 per 1,000 searches, plus tokens)
# VOLT_WEB_MAX_SEARCHES=20        # searches per run across all agents before they are told to stop
# SCRAPEGRAPH_API_KEY=            # set: a knowledge-base URL that needs a browser or blocks bots is rendered by ScrapeGraph (1 credit a page)
# ANIMATIONCHART_API_KEY=        # set: a request that asks for an animated chart or diagram can build it in AnimationChart (an outside service that stores what it is sent; uses AnimationChart AI credits)
# VOLT_MODE=                      # force "live" or "demo"
# VOLT_PLUGIN_DIR=../../plugins/volt   # the VOLT plugin the console reads
# VOLT_TEMPLATE_DIR=data/templates     # uploaded templates and their extracted profiles
# PORT=8787
