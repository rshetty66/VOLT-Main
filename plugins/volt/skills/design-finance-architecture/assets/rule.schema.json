{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finance-architecture:rule:2.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "rule_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "basis": { "type": "string", "minLength": 1 },
    "jurisdiction": { "type": "string", "minLength": 1 },
    "valid_from": { "type": "string", "format": "date" },
    "valid_to": { "type": "string", "format": "date" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["DRAFT", "READY_FOR_REVIEW", "APPROVED", "RETIRED"] },
    "policy_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "predicate_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "disposition": { "enum": ["NO_JOURNAL", "JOURNAL", "MEASUREMENT_REQUIRED", "DISCLOSURE_OR_REGULATORY_ONLY", "BLOCKED"] },
    "representation": { "enum": ["BASE", "DELTA"] },
    "measurement_owner": { "type": "string", "minLength": 1 },
    "posting_owner": { "type": "string", "minLength": 1 },
    "ledger": { "type": "string", "minLength": 1 },
    "journal_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "account_role": { "type": "string", "minLength": 1 },
          "side": { "enum": ["DEBIT", "CREDIT"] },
          "amount_source_ref": { "type": "string", "minLength": 1 },
          "dimension_rule_ref": { "type": "string", "minLength": 1 }
        },
        "required": ["account_role", "side", "amount_source_ref", "dimension_rule_ref"]
      }
    },
    "reporting_crosswalk_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "approval_evidence_ref": { "type": ["string", "null"] }
  },
  "required": [
    "schema_version", "tenant_id", "rule_id", "version", "basis", "jurisdiction", "valid_from", "valid_to",
    "recorded_at", "status", "policy_refs", "predicate_refs", "disposition", "representation", "measurement_owner",
    "posting_owner", "ledger", "journal_templates", "reporting_crosswalk_refs", "approval_evidence_ref"
  ],
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "APPROVED" } } },
      "then": { "properties": { "approval_evidence_ref": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "disposition": { "const": "JOURNAL" } } },
      "then": { "properties": { "journal_templates": { "minItems": 2 } } }
    }
  ]
}
